{
  "name": "bikerent-ui",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n css,cljs \"npm:watch:css\" \"npm:watch:cljs\"",
    "watch:css": "tailwindcss -i src/css/main.css -o public/css/main.css --watch",
    "watch:cljs": "shadow-cljs watch app",
    "build": "tailwindcss -i src/css/main.css -o public/css/main.css --minify && shadow-cljs release app"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "shadow-cljs": "2.28.20",
    "tailwindcss": "3.4.17"
  }
}
