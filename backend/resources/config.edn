;; Configuração do sistema Integrant, lida com Aero (#env, #or, #long).
{:bikerent.db/datasource                         {:url       #env DATABASE_URL
                                                  :pool-size 5
                                                  :migrate?  true}

 :bikerent.users.adapters.postgres/repository    {:datasource #ig/ref :bikerent.db/datasource}
 :bikerent.listings.adapters.postgres/repository {:datasource #ig/ref :bikerent.db/datasource}

 :bikerent.http/handler                          {:datasource #ig/ref :bikerent.db/datasource
                                                  :users      #ig/ref :bikerent.users.adapters.postgres/repository
                                                  :listings   #ig/ref :bikerent.listings.adapters.postgres/repository
                                                  :jwt-secret #or [#env JWT_SECRET "dev-secret-troque-no-deploy"]}

 :bikerent.http/server                           {:handler #ig/ref :bikerent.http/handler
                                                  :port    #long #or [#env PORT 3000]}}
