{:paths ["src" "resources"]

 :deps {org.clojure/clojure                {:mvn/version "1.12.0"}
        org.clojure/tools.logging          {:mvn/version "1.3.0"}
        org.slf4j/slf4j-simple             {:mvn/version "2.0.16"}
        integrant/integrant                {:mvn/version "0.13.1"}
        aero/aero                          {:mvn/version "1.1.6"}
        ring/ring-jetty-adapter            {:mvn/version "1.13.0"}
        ring-cors/ring-cors                {:mvn/version "0.1.13"}
        metosin/reitit                     {:mvn/version "0.7.2"}
        metosin/muuntaja                   {:mvn/version "0.6.10"}
        metosin/malli                      {:mvn/version "0.16.4"}
        com.github.seancorfield/next.jdbc  {:mvn/version "1.3.955"}
        com.github.seancorfield/honeysql   {:mvn/version "2.6.1230"}
        org.postgresql/postgresql          {:mvn/version "42.7.4"}
        com.zaxxer/HikariCP                {:mvn/version "6.2.1"}
        migratus/migratus                  {:mvn/version "1.6.3"}
        buddy/buddy-sign                   {:mvn/version "3.6.1-359"}
        buddy/buddy-hashers                {:mvn/version "2.0.167"}
        org.clojure/core.async             {:mvn/version "1.6.681"}}

 :aliases
 {;; REPL de desenvolvimento: (go), (reset), (halt)
  :dev     {:extra-paths ["dev" "test"]
            :extra-deps  {integrant/repl {:mvn/version "0.3.3"}}}

  ;; clojure -M:run
  :run     {:main-opts ["-m" "bikerent.main"]}

  ;; clojure -M:migrate [migrate|rollback|create <nome>]
  :migrate {:main-opts ["-m" "bikerent.db"]}

  ;; clojure -M:test
  :test    {:extra-paths ["test"]
            :extra-deps  {io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            :main-opts   ["-m" "cognitect.test-runner"]}}}
