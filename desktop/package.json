{
  "name": "2bike4-desktop",
  "productName": "2bike4",
  "version": "1.0.0",
  "description": "2bike4 para Windows: aluguel de bicicletas entre pessoas",
  "main": "main.js",
  "author": "2bike4",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.twobike4.desktop",
    "productName": "2bike4",
    "files": [
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "2bike4-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
